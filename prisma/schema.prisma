// SponFy Canonical Prisma Schema (docs/database.md)
// PostgreSQL on Neon Serverless

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Stage {
  DISCOVERED
  RESEARCHED
  QUALIFIED
  CONTACT_FOUND
  DRAFT_READY
  APPROVED
  CONTACTED
  REPLIED
  INTERESTED
  NEGOTIATION
  COMMITTED
  LOST
}

enum ContactStatus {
  VERIFIED
  PUBLIC
  NEEDS_VERIFICATION
  UNKNOWN
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  FAILED
}

enum DraftKind {
  INITIAL
  FOLLOWUP
  REPLY
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum Intent {
  INTERESTED
  POSITIVE
  NEEDS_INFO
  NEGOTIATING
  NOT_INTERESTED
  MAYBE_LATER
  OUT_OF_OFFICE
  UNCLEAR
}

enum JobType {
  DISCOVERY
  RESEARCH
  OUTREACH
  REPLY_ANALYSIS
  INSIGHTS
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  DRAFTED
  SENT
  CANCELLED
  SKIPPED
}

enum GmailStatus {
  ACTIVE
  REVOKED
}

enum ResearchStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
}

enum Role {
  USER
  EXECUTIVE
  ORGANISER
  ADMIN
}

enum AccountMode {
  INDIVIDUAL
  ORGANISER
  EXECUTIVE
}

enum OnboardingStatus {
  NOT_STARTED
  DETAILS_DONE
  PENDING_APPROVAL
  COMPLETE
}

enum OrgRole {
  ORGANISER
  EXECUTIVE
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

// ---------- Auth.js (Standard Adapter Models) ----------

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  password      String?
  emailVerified DateTime?
  image         String?
  orgName       String?
  orgType       String?
  onboarded     Boolean       @default(false)
  phone         String?
  designation   String?
  department    String?
  collegeOrCompany String?
  accountMode   AccountMode   @default(INDIVIDUAL)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  lastActiveAt  DateTime?
  dailySendCap  Int           @default(30)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts       Account[]
  sessions       Session[]
  campaigns      Campaign[]
  companies      Company[]
  contacts       Contact[]
  drafts         EmailDraft[]
  messages       Message[]
  analyses       ReplyAnalysis[]
  sequences      FollowupSequence[]
  tasks          FollowupTask[]
  activities     Activity[]
  jobs           AiJob[]
  suppressions   Suppression[]
  insights       Insight[]
  gmailAccount   GmailAccount?
  auditLogs      AuditLog[]
  userActivities   UserActivityLog[]
  discoveryResults DiscoveryResult[]
  meetings         Meeting[]

  // Organisation & Member relations
  createdOrganisations    Organisation[]       @relation("OrganisationCreator")
  organisationMemberships  OrganisationMember[] @relation("OrgMemberUser")
  decidedOrgMemberships    OrganisationMember[] @relation("OrgMemberDecider")
  campaignMemberships     CampaignMember[]
  accessRequests          AccessRequest[]      @relation("AccessRequester")
  decidedAccessRequests   AccessRequest[]      @relation("AccessDecider")
  notifications           Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Domain Models ----------

model Campaign {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  eventType           String
  audienceSize        Int
  location            String
  targetAmount        Int      // Whole INR
  preferredIndustries String[]
  tiers               Json     @default("[]")   // [{name, amount, perks[]}]
  deckUrl             String?
  description         String?
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  companies Company[]
  insights         Insight[]
  jobs             AiJob[]
  discoveryResults DiscoveryResult[]
  members          CampaignMember[]
  accessRequests   AccessRequest[]

  @@index([userId])
  @@index([organisationId])
  @@map("campaigns")
}

model Company {
  id              String         @id @default(cuid())
  userId          String
  campaignId      String
  name            String
  website         String?
  domain          String?                       // Normalised, for dedupe
  industry        String?
  description     String?
  whyRelevant     String?
  sponsorshipType String?
  stage           Stage          @default(DISCOVERED)
  fitScore        Int?
  scoreBreakdown  Json?                         // [{factor, points, maxPoints, reason, positive}]
  pipelineValue   Int            @default(0)   // Whole INR
  signals         Json           @default("[]") // [{label, url?, date?}]
  confidence      Int?                          // 0-100
  sponsorApproved Boolean        @default(true) // Distinguishes approved from unapproved
  researchStatus  ResearchStatus @default(NOT_STARTED)
  nextAction      Json?                         // {action, reason, generatedAt}
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  report     ResearchReport?
  sources    Source[]
  contacts   Contact[]
  drafts     EmailDraft[]
  activities Activity[]
  sequences  FollowupSequence[]

  @@unique([campaignId, domain])
  @@index([userId, campaignId])
  @@index([userId, stage])
  @@index([userId, createdAt(sort: Desc)])
  @@map("companies")
}

model ResearchReport {
  id               String   @id @default(cuid())
  companyId        String   @unique
  userId           String
  sections         Json     // {overview, products[], audience, recentInitiatives[], programs[], opportunities[], publicContactInfo}
  recommendedAngle String?
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("research_reports")
}

model Source {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  url       String
  title     String?
  snippet   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("sources")
}

model Contact {
  id        String        @id @default(cuid())
  userId    String
  companyId String
  name      String?
  role      String?
  email     String?
  status    ContactStatus @default(UNKNOWN)
  sourceUrl String?       // REQUIRED when status = PUBLIC (enforced in service)
  bounced   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts  EmailDraft[]

  @@index([userId, companyId])
  @@map("contacts")
}

model EmailDraft {
  id         String      @id @default(cuid())
  userId     String
  companyId  String
  contactId  String?
  kind       DraftKind   @default(INITIAL)
  subject    String
  body       String      @db.Text
  quality    Json?       // {personalization, relevance, clarity, cta, professionalism, overall, suggestions[]}
  status     DraftStatus @default(DRAFT)
  approvedAt DateTime?
  sentAt          DateTime?
  needsAttention  Boolean     @default(false)
  attentionReason String?
  error           String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact  Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, status])
  @@index([companyId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("email_drafts")
}

model Message {
  id             String      @id @default(cuid())
  userId         String
  companyId      String?
  draftId        String?
  gmailMessageId String?     @unique
  gmailThreadId  String?
  direction      Direction
  fromEmail      String?
  toEmail        String?
  subject        String?
  body           String      @db.Text
  isMock         Boolean     @default(false)
  sentAt         DateTime
  createdAt      DateTime    @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft    EmailDraft?    @relation(fields: [draftId], references: [id], onDelete: SetNull)
  analysis ReplyAnalysis?

  @@index([userId, gmailThreadId])
  @@index([companyId])
  @@index([userId, sentAt(sort: Desc)])
  @@map("messages")
}

model ReplyAnalysis {
  id               String   @id @default(cuid())
  userId           String
  messageId        String   @unique
  intent           Intent
  sentiment        String
  confidence       Int
  summary          String
  questions        Json     @default("[]")
  requestedInfo    String?
  nextAction       String
  urgency          String
  meetingRequested Boolean  @default(false)
  createdAt        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reply_analyses")
}

model FollowupSequence {
  id            String   @id @default(cuid())
  userId        String
  companyId     String
  steps         Json     // [{waitDays, kind}] default [{4},{7}]
  maxFollowups  Int      @default(2)
  active        Boolean  @default(true)
  stoppedReason String?
  createdAt     DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks   FollowupTask[]

  @@index([userId, active])
  @@map("followup_sequences")
}

model FollowupTask {
  id             String     @id @default(cuid())
  userId         String
  sequenceId     String
  dueAt          DateTime
  status         TaskStatus @default(PENDING)
  recommendation Json?      // {shouldFollowUp, reason}
  draftId        String?
  createdAt      DateTime   @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence FollowupSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@map("followup_tasks")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  type      String   // company_discovered, research_completed, contact_added, draft_approved, email_sent, reply_received, stage_changed
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@map("activities")
}

model AiJob {
  id         String    @id @default(cuid())
  userId     String
  campaignId String?
  companyId  String?
  type       JobType
  status     JobStatus @default(QUEUED)
  step       String?
  progress   Int       @default(0)   // 0-100
  counts     Json?                   // {found, researched, scored}
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ai_jobs")
}

model GmailAccount {
  id              String      @id @default(cuid())
  userId          String      @unique
  email           String
  refreshTokenEnc String      @db.Text   // AES-256-GCM encrypted
  accessTokenEnc  String?     @db.Text
  expiresAt       DateTime?
  scopes          String
  status          GmailStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_accounts")
}

model Suppression {
  id        String   @id @default(cuid())
  userId    String
  email     String
  reason    String   // not_interested | bounced | manual
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@map("suppressions")
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String
  text        String   @db.Text
  basis       Json?    // {sentCount, repliesCount}
  generatedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, campaignId])
  @@map("insights")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // user_suspended | user_restored | user_deleted | role_changed | campaign_archived | settings_updated
  targetType String   // user | campaign | system
  targetId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model UserActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // login | heartbeat | page_view | campaign_created | email_sent
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_activity_logs")
}

model ShowcaseCompany {
  id               String   @id @default(cuid())
  name             String
  websiteUrl       String
  logoUrl          String?
  industry         String
  shortDescription String
  sortOrder        Int      @default(0)
  isVisible        Boolean  @default(true)
  isPartner        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder, isVisible])
  @@map("showcase_companies")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  targetType String
  targetId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([adminEmail, createdAt])
  @@map("admin_logs")
}

model DiscoveryResult {
  id              String         @id @default(cuid())
  userId          String
  campaignId      String
  name            String
  website         String?
  domain          String?
  industry        String?
  description     String?
  whyRelevant     String?
  sponsorshipType String?
  fitScore        Int?
  pipelineValue   Int            @default(0)
  signals         Json           @default("[]")
  confidence      Int?
  researchStatus  ResearchStatus @default(NOT_STARTED)
  scoreBreakdown  Json?
  query           String?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, campaignId])
  @@index([expiresAt])
  @@map("discovery_results")
}

model EmailVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  provider     String   // hunter | zerobounce | tiered
  status       String   // VALID | INVALID | DISPOSABLE | ACCEPT_ALL | RISKY | UNKNOWN
  subStatus    String?
  score        Int?
  isDeliverable Boolean  @default(false)
  isDisposable Boolean  @default(false)
  isAcceptAll  Boolean  @default(false)
  rawResponse  Json?    @default("{}")
  checkedAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("email_verifications")
}

model EmailTrackingEvent {
  id        String   @id @default(cuid())
  messageId String
  type      String   // send_attempted | accepted | delivered | opened | clicked | bounced | replied
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([type])
  @@index([createdAt])
  @@map("email_tracking_events")
}

model Meeting {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  companyName    String
  campaignId     String?
  contactName    String?
  contactEmail   String?
  replyMessageId String?
  title          String
  startsAt       DateTime
  durationMins   Int
  mode           String   // video | phone | in_person
  location       String
  notes          String?
  status         String   @default("scheduled") // scheduled | completed | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startsAt])
  @@map("meetings")
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   // College Club, Company, NGO, Fest Committee, Other
  description String?
  website     String?
  city        String?
  logoUrl     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User                 @relation("OrganisationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members        OrganisationMember[]
  campaigns      Campaign[]
  accessRequests AccessRequest[]

  @@index([createdById])
  @@map("organisations")
}

model OrganisationMember {
  id             String       @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole
  status         MemberStatus
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("OrgMemberDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, status])
  @@map("organisation_members")
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  userId     String
  role       OrgRole
  status     MemberStatus
  createdAt  DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, status])
  @@map("campaign_members")
}

model AccessRequest {
  id             String        @id @default(cuid())
  requesterId    String
  campaignId     String
  organisationId String?
  requestedRole  OrgRole
  message        String?
  details        Json          @default("{}")
  status         RequestStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime      @default(now())

  requester    User          @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy    User?         @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([requesterId])
  @@index([organisationId])
  @@map("access_requests")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}




