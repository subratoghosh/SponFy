# Neon Serverless PostgreSQL & Prisma ORM Database Connection
# Pooled connection string (recommended for serverless & queries):
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (recommended for Prisma migrations & schema push):
DIRECT_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI & Search APIs
GEMINI_API_KEY=your-gemini-api-key
TAVILY_API_KEY=your-tavily-api-key

# Google OAuth & Gmail API (Send & Read scopes)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Security & Background Crons
TOKEN_ENCRYPTION_KEY=32-byte-hex-string-for-aes-256-encryption-key-0123
CRON_SECRET=super-secret-cron-token-for-reply-sync

# App Environment & NextAuth
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-random-32-character-secret-key-here
NEXTAUTH_SECRET=your-random-32-character-secret-key-here
NEXT_PUBLIC_DEMO_MODE=true

# Admin Access Control (comma-separated list of server-verified admin emails)
# Users with these email addresses are assigned the ADMIN role upon sign-in.
ADMIN_EMAILS="admin@sponfy.dev,organizer@sponfy.dev"

