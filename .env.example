# ==============================================================================
# SPONFY ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables in Settings -> Environment Variables.
# Separate variables appropriately across Production, Preview, and Development.
# NEVER commit real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL APP & DEPLOYMENT URLS
# ------------------------------------------------------------------------------
# Canonical production site URL used for metadataBase, sitemap, robots, OpenGraph.
# On Vercel: set to your stable production URL (e.g., https://sponfy.vercel.app or custom domain)
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "false" in production with a live database.
# Set to "true" to run with seed mock repositories and in-memory demo store.
NEXT_PUBLIC_DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 2. MANAGED NEON POSTGRESQL & PRISMA ORM
# ------------------------------------------------------------------------------
# Pooled connection string (required for serverless queries):
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (required for Prisma migrate & schema push):
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTH.JS (NEXTAUTH V5) AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically random 32-character string:
# Command: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-32-character-secret-key-for-auth"
NEXTAUTH_SECRET="generate-a-secure-32-character-secret-key-for-auth"

# Admin Access Control (comma-separated list of server-verified admin emails).
# Users with these emails are assigned the ADMIN role upon login.
ADMIN_EMAILS="admin@sponfy.dev,organizer@sponfy.dev"

# ------------------------------------------------------------------------------
# 4. OAUTH PROVIDERS (GOOGLE & GITHUB)
# ------------------------------------------------------------------------------
# Google Cloud Console (OAuth 2.0 Web Application credentials):
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail API OAuth Redirect URI (for mailbox integration):
# Authorized redirect URI: https://<your-domain>/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# GitHub OAuth App (Optional social login):
# Authorized callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte hex string (64 characters) for AES-256-GCM token encryption:
# Command: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secret token used by Vercel Cron or external scheduler to trigger background jobs:
# Call: GET /api/cron/sync-replies with Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-random-secret-token-for-cron-invocations"

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING & GLOBAL CACHE (UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Free serverless Redis from https://console.upstash.com
# Provides multi-region rate limiting across serverless function instances.
# If omitted, SponFy automatically falls back to an in-memory sliding window rate limiter.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# 7. AI, SEARCH & SCRAPING PROVIDERS
# ------------------------------------------------------------------------------
# Groq (Free fast inference for relevance filtering & draft quality evaluation):
# Get key from https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini (Dossier research & pitch generation):
# Get key from https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Tavily (Live web search for sponsor discovery):
# Get key from https://tavily.com
TAVILY_API_KEY=""

# Firecrawl (Deep sponsor website content scraper, optional):
# Get key from https://firecrawl.dev
FIRECRAWL_API_KEY=""

# xAI Grok (Alternative LLM provider, optional):
XAI_API_KEY=""

# ------------------------------------------------------------------------------
# 8. DELIVERABILITY & VERIFICATION PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Hunter.io (Professional contact discovery & verification):
HUNTER_API_KEY=""

# ZeroBounce (Email validation & spam-trap shield):
ZEROBOUNCE_API_KEY=""
